{
  "name": "shell-format-secure",
  "displayName": "Shell-like Formatter Secure",
  "description": "Revision of shell-format: A formatter for shell-like scripts, Dockerfile, gitignore, dotenv, /etc/hosts, jvmoptions, and other file types",
  "version": "0.0.0-semantic-release",
  "publisher": "vs-shell-format",
  "engines": {
    "vscode": "^1.36.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:shellscript",
    "onLanguage:dotenv",
    "onLanguage:dockerfile",
    "onLanguage:ignore",
    "onLanguage:hosts",
    "onLanguage:jvmoptions",
    "onLanguage:properties",
    "onLanguage:spring-boot-properties",
    "onLanguage:azcli",
    "onLanguage:bats",
    "onLanguage:zsh"
  ],
  "main": "./dist/extension",
  "capabilities": {
    "documentFormattingProvider": "true",
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "shellformat.path",
        "shellformat.flag"
      ]
    }
  },
  "icon": "logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/fast-facts/vs-shell-format.git"
  },
  "bugs": {
    "url": "https://github.com/fast-facts/vs-shell-format/issues"
  },
  "keywords": [
    "shell",
    "docker",
    "shellscript",
    "format",
    "bash",
    "dockerfile",
    "properties",
    "formatter",
    "beautify",
    "dotenv",
    "hosts",
    "jvmoptions",
    "vmoptions",
    "bashrc",
    "zshrc",
    "azcli",
    "azure cli tool",
    "bats"
  ],
  "contributes": {
    "languages": [
      {
        "id": "shellscript"
      },
      {
        "id": "dockerfile",
        "aliases": [
          "docker",
          "Dockerfile"
        ],
        "filenamePatterns": [
          "Dockerfile",
          "Dockerfile.*",
          "*.dockerfile"
        ]
      },
      {
        "id": "ignore",
        "aliases": [
          "gitignore",
          "dockerignore"
        ],
        "filenames": [
          ".dockerignore",
          ".gitignore"
        ]
      },
      {
        "id": "dotenv",
        "aliases": [
          "env"
        ],
        "filenamePatterns": [
          ".env.*"
        ],
        "filenames": [
          "env",
          ".env"
        ]
      },
      {
        "id": "jvmoptions",
        "aliases": [
          "vmoptions"
        ],
        "extensions": [
          ".vmoptions"
        ],
        "filenames": [
          "jvm.options"
        ]
      },
      {
        "id": "hosts",
        "filenames": [
          "hosts"
        ]
      },
      {
        "id": "properties",
        "aliases": [
          "Properties",
          "spring-boot-properties"
        ],
        "extensions": [
          ".properties"
        ]
      },
      {
        "id": "azcli",
        "extensions": [
          ".azcli"
        ]
      },
      {
        "id": "bats",
        "extensions": [
          ".bats"
        ]
      },
      {
        "id": "zsh",
        "extensions": [
          ".zsh"
        ],
        "filenames": [
          ".zshrc",
          ".zshenv",
          ".zprofile",
          ".zlogin",
          ".zlogout"
        ]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "shell-format configuration",
      "properties": {
        "shellformat.path": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "scope": "application",
          "restricted": true,
          "description": "the shfmt fullpath  example[mac,linux] /usr/local/bin/shfmt  [windows] C:/bin/shfmt.exe   download from https://github.com/mvdan/sh/releases. User setting only; a workspace cannot set this."
        },
        "shellformat.flag": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "scope": "application",
          "restricted": true,
          "description": "shfmt -h to see detail usage, example: -p -bn -ci. User setting only; a workspace cannot set this."
        },
        "shellformat.effectLanguages": {
          "type": "array",
          "default": [
            "shellscript",
            "dotenv",
            "hosts",
            "jvmoptions",
            "ignore",
            "properties",
            "spring-boot-properties",
            "azcli",
            "bats",
            "zsh"
          ],
          "description": "the trigger effect  on the language"
        },
        "shellformat.useEditorConfig": {
          "type": "boolean",
          "default": false,
          "description": "Use EditorConfig for shfmt configuration"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "compile": "tsc -p ./",
    "watch": "tsc -p ./ --watch",
    "test-compile": "tsc -p tsconfig.test.json",
    "pretest": "npm run compile && npm run test-compile",
    "test": "node ./out/test/runTest.js"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "semantic-release-vsce",
        {
          "packageVsix": true
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": "*.vsix"
        }
      ]
    ]
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "24.13.4",
    "@types/vscode": "^1.137.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "glob": "^13.0.6",
    "mocha": "^12.0.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "editorconfig": "^3.0.2"
  },
  "licenses": [
    {
      "type": "MIT",
      "url": "https://www.opensource.org/licenses/mit-license.php"
    }
  ]
}
